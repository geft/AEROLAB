{
  "name": "run-progress",
  "version": "1.0.0",
  "description": "Local Running Progress Dashboard with LT1/LT2 and Running Economy Tracking",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:frontend": "vite",
    "dev": "node scripts/start-all.js",
    "start": "node scripts/start-all.js",
    "build": "vite build",
    "build:all": "node scripts/build-all.js",
    "electron:start": "node scripts/build-all.js && electron .",
    "electron:build": "node scripts/build-all.js && electron-builder --win",
    "update": "node scripts/update-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx scripts/ingest.ts",
    "process:fit": "tsx scripts/batch-process-fit.ts"
  },
  "build": {
    "appId": "com.aerolab.app",
    "productName": "AEROLAB",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-backend/**/*",
      "electron/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
