{
  "name": "run-progress",
  "version": "1.1.0",
  "description": "Local Running Progress Dashboard with LT1/LT2 and Running Economy Tracking",
  "type": "module",
  "scripts": {
    "dev:backend": "tsx watch src/backend/server.ts",
    "dev:frontend": "vite",
    "dev": "node scripts/start-all.js",
    "start": "node scripts/start-all.js",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "vite build",
    "snapshot:export": "tsx scripts/export-snapshot.ts",
    "snapshot:validate": "tsx scripts/validate-snapshot.ts",
    "build:snapshot": "node scripts/build-snapshot.js",
    "build:all": "node scripts/build-all.js",
    "smoke:packaged": "node scripts/smoke-packaged.js",
    "update": "node scripts/update-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "playwright test",
    "test:snapshot:visual": "playwright test --config=playwright.snapshot.config.ts",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report",
    "visual": "node scripts/visual-review.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "i18n:unused": "node scripts/find-unused-i18n-keys.mjs",
    "db:location": "tsx scripts/configure-database.ts",
    "ingest": "tsx scripts/ingest.ts",
    "realign": "tsx scripts/realign.ts",
    "app": "node scripts/launch-chrome-app.js",
    "start:chrome": "node scripts/launch-chrome-app.js",
    "package:chromium-free": "node scripts/package-chromium-free.js",
    "package-chromium-free": "node scripts/package-chromium-free.js",
    "package": "node scripts/package-chromium-free.js",
    "build:installer": "node scripts/package-chromium-free.js",
    "installer": "node scripts/package-chromium-free.js",
    "process:fit": "tsx scripts/batch-process-fit.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.11"
  }
}
