# Dependencies
node_modules/
.vercel/

# Production build
dist/
dist-snapshot/
dist-snapshot-template/
dist-backend/
snapshot-data/
public/snapshot.json
public/snapshot.msgpack.gz
release/

# Compiled Windows launchers / installers
# AEROLAB.exe is rebuilt from launcher.cs by scripts/build-all.js during packaging.
# `npm run dev` and `npm run app` never need it, so it must not be tracked.
*.exe

# Test coverage
coverage/
test-results/
playwright-report/
/.playwright-cli/

# Local scratch scripts
scratch/
/output/

# Local workout data, backups and database experiments
/data/

# Databases saved elsewhere in the checkout
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Temporary / raw drops (raw files should never be committed to git)
*.csv
*.fit
*.FIT
*.tcx
*.gpx

# Environment & logs
.env*
*.log
npm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
