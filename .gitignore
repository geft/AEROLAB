# Dependencies
node_modules/
/.vercel/

# Production build
dist/
dist-snapshot/
dist-snapshot-template/
dist-backend/
snapshot-data/
public/snapshot.json
public/snapshot.msgpack.gz
release/

# Compiled Windows launchers / installers
# AEROLAB.exe is rebuilt from launcher.cs by scripts/build-all.js during packaging.
# `npm run dev` and `npm run app` never need it, so it must not be tracked.
*.exe

# Test coverage
coverage/
test-results/
playwright-report/

# Local scratch scripts
scratch/

# Local databases
data/*.db
data/*.db-wal
data/*.db-shm
data/**/*.db
data/**/*.db-wal
data/**/*.db-shm
data/backups/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Temporary / raw drops (raw files should never be committed to git)
data/raw/*
!data/raw/.gitkeep
*.csv
*.fit
*.FIT
*.tcx
*.gpx

# Environment & logs
.env
.env.local
*.log
npm-debug.log*

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

.vercel
.env*
